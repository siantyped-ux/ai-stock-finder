# ================================================================
#  AI 3-Month Stock Finder - API 키 설정
# ================================================================
#  이 파일을 .env 로 복사(또는 이름 변경)한 후 실제 키를 입력하세요.
#     PowerShell:  Copy-Item .env.example .env
#
#  키가 비어있으면 해당 API는 스킵되고 프록시 스코어로 대체됩니다.
#  둘 다 없어도 yfinance 기반 스코어링은 정상 작동합니다.
# ================================================================

# ─── FMP (Financial Modeling Prep) Ultimate 플랜 ─────────────
# 미국 SEC 공시: 13F 헤지펀드 컨센서스, Form 4 내부자거래, 8-K 이벤트
# 발급: https://financialmodelingprep.com/  (Ultimate 플랜 필요)
# 무료 플랜은 rate limit 낮음 · Ultimate = 3000 req/min
FMP_API_KEY=

# ─── DART (금융감독원 전자공시) OpenAPI ────────────────────
# 한국 공시: 대량보유(5%), 임원매매, 자기주식, 유상증자/CB
# 발급: https://opendart.fss.or.kr/  (무료, 이메일 인증)
# 한도: 일 20,000 req · 분당 1,000 미만 (초당 10~15 권고)
DART_API_KEY=

# ─── (선택) FRED API - 매크로 지표 정밀화 ──────────────────
# 발급: https://fred.stlouisfed.org/docs/api/api_key.html  (무료)
# 미설정 시 yfinance의 ^VIX / DX-Y.NYB / ^TNX 사용
FRED_API_KEY=

# ─── (선택) Anthropic API - LLM 기반 8-K 이벤트 감성 분석 ─
# 발급: https://console.anthropic.com/
# 미설정 시 이벤트 수 카운트만 반영
ANTHROPIC_API_KEY=

# ─── 실행 모드 ────────────────────────────────────────────
# paper: 리서치 전용 (기본)
# live: 실계좌 연동 (별도 브로커 API 필요, 미구현)
TRADING_MODE=paper
